/* 1. 让全站背景透出天空之城 */
body {
    background-color: rgba(255, 255, 255, 0.2) !important; /* 遮罩降到 0.2，让图露出来 */
    background-blend-mode: overlay;
}

/* 2. 让装文章的大白盒子变透明（这是透明看不出来的关键） */
#content-inner,
#page,
.recent-post-item,
.card-widget {
    background: rgba(255, 255, 255, 0.6) !important; 
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.5) !important;
}

/* 3. 翻页卡片：给它上渐变色，绝对一眼看出毛玻璃 */
#pagination .pagination-related {
    background: transparent !important;
    box-shadow: none !important;
}

#pagination .info {
    /* 淡蓝色到淡紫色的渐变，半透明 */
    background: linear-gradient(135deg, rgba(200, 230, 255, 0.5), rgba(220, 210, 255, 0.5)) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1.5px solid rgba(255, 255, 255, 0.9) !important;
    border-radius: 16px;
    padding: 40px 30px !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2) !important;
    transition: all 0.3s;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

#pagination .info * {
    color: #1a1a1a !important;
}
#pagination .info-item-2 {
    font-size: 1.3rem !important;
    font-weight: bold !important;
    margin-top: 8px;
}
#pagination .info-item-1 {
    font-size: 0.9rem !important;
    color: #555 !important;
}
#pagination .info.text-right {
    text-align: right !important;
}
#pagination .info:not(.text-right) {
    text-align: left !important;
}

/* 鼠标放上去 */
#pagination .info:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.3) !important;
    background: linear-gradient(135deg, rgba(200, 230, 255, 0.7), rgba(220, 210, 255, 0.7)) !important;
}

/* 4. 适配深色模式 */
[data-theme="dark"] body {
    background-color: rgba(0, 0, 0, 0.6) !important;
}
[data-theme="dark"] #content-inner,
[data-theme="dark"] .recent-post-item,
[data-theme="dark"] .card-widget {
    background: rgba(30, 30, 30, 0.6) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
}
[data-theme="dark"] #pagination .info {
    background: linear-gradient(135deg, rgba(40, 50, 70, 0.6), rgba(50, 40, 70, 0.6)) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
}
[data-theme="dark"] #pagination .info * {
    color: #fff !important;
}
